NODE_ENV=production
API_PORT=3001

DATABASE_URL=postgresql://crm:crmpassword@postgres:5432/open333crm
DATABASE_URL_ADMIN=postgresql://app_admin:change-me@postgres:5432/open333crm
REDIS_URL=redis://redis:6379
CACHE_DRIVER=redis

JWT_SECRET=change-me-to-a-very-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# WebAuthn / Passkey (optional; enable only after setting the production values)
# WEBAUTHN_RP_ID=crm.example.com
# WEBAUTHN_RP_NAME=open333CRM
# WEBAUTHN_ORIGIN=https://crm.example.com
# WEBAUTHN_CHALLENGE_TTL_SECONDS=120


CREDENTIAL_ENCRYPTION_KEY=change-me-32-bytes-encryption-key!!

API_BASE_URL=https://crm.example.com
NEXT_PUBLIC_WEB_URL=https://crm.example.com
MCP_ALLOWED_ORIGINS=https://crm.example.com
# Optional: only set this when widget.js is served from a different public origin.
# WEB_BASE_URL=https://static.example.com

STORAGE_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=open333crm
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000
S3_SET_ACL=0

OLLAMA_BASE_URL=http://ollama:11434

# ─── Agentic LLM ────────────────────────────────────────────────────────────
# The Agent can use live web search/read, OCR, doc parsing, and optional Wiki publishing.
AGENTIC_LLM_ENABLED=true
AGENT_MAX_TURNS=100
AGENT_MAX_TOOL_CALLS=30
AGENT_TIMEOUT_MS=120000
AGENT_MAX_TOTAL_TOKENS=100000
AGENT_WIKI_AUTO_PUBLISH=false
# WIKI_API_TOKEN=

# Official 888a2a bridge metadata. Hub key/token stay outside the API env.
A2A_BRIDGE_ENABLED=false
A2A_HUB_URL=https://a2a.david888.com
# A2A_AGENT_ID=agent-id-for-safe-status-display

# ─── WebTalk 協作工具列（change webtalk-multi-tenant）───────────────────────────
# WEBTALK_ROOM_SECRET 與 WEBTALK_SDK_URL 任一沒設定（或密鑰少於 32 字元、網址不是 https）時，
# 所有租戶都不載入 WebTalk（fail-closed）。每個環境請用不同的密鑰：openssl rand -base64 48
# 更換密鑰會讓所有租戶換到新房間（舊房間代號全部作廢）。
# WEBTALK_ROOM_SECRET=
# 環境識別，參與房間代號推導，例如 open333crm-uat、open333crm-prod
WEBTALK_SITE_ID=open333crm-local
# WEBTALK_SDK_URL=https://webtalk-nine.vercel.app/webtalk.js
# 選填：SDK 的 SRI 雜湊（例如 sha384-...）。目前 SDK 網址沒有版本，上游更新就會對不上，鎖版本後再設。
# WEBTALK_SDK_INTEGRITY=
# 選填：AI 摘要端點。沒設定時即使租戶開啟 AI 摘要也不會送出頁面內容。
# 注意：AI 摘要會把整頁文字（含顧客個資）送到這個端點。
# WEBTALK_AI_ENDPOINT=https://webtalk-nine.vercel.app/api/webtalk/ai

# ─── Logging ──────────────────────────────────────────────────────────────────
# LOG_TRANSPORT: console | file | both  (default: console)
#   console - stdout only (colorized, dev-friendly)
#   file    - daily rotating JSON log files only
#   both    - stdout + file simultaneously
LOG_TRANSPORT=console

# LOG_DIR: directory for log files when LOG_TRANSPORT=file|both (default: ./logs)
LOG_DIR=./logs

# LOG_MAX_FILES: retention period for rotated log files (default: 14d)
#   Accepts: "14d" (days), "30d", etc. Files older than this are auto-deleted and gzipped.
LOG_MAX_FILES=14d

# LOG_LEVEL: minimum log level (default: info)
#   Levels: error | warn | info | debug
LOG_LEVEL=info

# Public Chatbox session lifetime is capped at 3 days (4320 minutes).
CHATBOX_SESSION_TTL_MINUTES=4320
# Keep legacy visitor-token routes disabled; secure Chatbox sessions are required.
WEBCHAT_LEGACY_ROUTES_ENABLED=false

# ─── Email delivery ──────────────────────────────────────────────────────────
# Delivery modes: resend | log | webhook | smtp
EMAIL_DELIVERY_MODE=resend
RESEND_API_KEY=re_your_server_side_api_key
# The sender domain must be verified in Resend before production use.
EMAIL_FROM=open333CRM <noreply@aitago.tw>
# SMTP_* is only needed when EMAIL_DELIVERY_MODE=smtp is used for rollback.

# ─── Upload content detection ───────────────────────────────────────────────
# Enabled by default. Set false only for emergency rollback; this lowers upload security.
UPLOAD_CONTENT_DETECTION_ENABLED=true
