NODE_ENV=production
API_PORT=3001

DATABASE_URL=postgresql://crm:crmpassword@postgres:5432/open333crm
REDIS_URL=redis://redis:6379
CACHE_DRIVER=redis

JWT_SECRET=change-me-to-a-very-long-random-string-at-least-32-chars
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_EXPIRES_IN=30d

# WebAuthn / Passkey (optional; enable only after setting the production values)
# WEBAUTHN_RP_ID=crm.example.com
# WEBAUTHN_RP_NAME=open333CRM
# WEBAUTHN_ORIGIN=https://crm.example.com
# WEBAUTHN_CHALLENGE_TTL_SECONDS=120


CREDENTIAL_ENCRYPTION_KEY=change-me-32-bytes-encryption-key!!

API_BASE_URL=https://crm.example.com
NEXT_PUBLIC_WEB_URL=https://crm.example.com
MCP_ALLOWED_ORIGINS=https://crm.example.com
# Optional: only set this when widget.js is served from a different public origin.
# WEB_BASE_URL=https://static.example.com

STORAGE_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=open333crm
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000
S3_SET_ACL=0

OLLAMA_BASE_URL=http://ollama:11434

# ─── Agentic LLM (opt-in) ────────────────────────────────────────────────────
# The Agent can use live web search/read, weather, and optional Wiki publishing.
AGENTIC_LLM_ENABLED=false
AGENT_MAX_TURNS=100
AGENT_MAX_TOOL_CALLS=30
AGENT_TIMEOUT_MS=120000
AGENT_MAX_TOTAL_TOKENS=100000
AGENT_WIKI_AUTO_PUBLISH=false
# WIKI_API_TOKEN=

# ─── Logging ──────────────────────────────────────────────────────────────────
# LOG_TRANSPORT: console | file | both  (default: console)
#   console - stdout only (colorized, dev-friendly)
#   file    - daily rotating JSON log files only
#   both    - stdout + file simultaneously
LOG_TRANSPORT=console

# LOG_DIR: directory for log files when LOG_TRANSPORT=file|both (default: ./logs)
LOG_DIR=./logs

# LOG_MAX_FILES: retention period for rotated log files (default: 14d)
#   Accepts: "14d" (days), "30d", etc. Files older than this are auto-deleted and gzipped.
LOG_MAX_FILES=14d

# LOG_LEVEL: minimum log level (default: info)
#   Levels: error | warn | info | debug
LOG_LEVEL=info

# Public Chatbox session lifetime is capped at 3 days (4320 minutes).
CHATBOX_SESSION_TTL_MINUTES=4320
# Keep legacy visitor-token routes disabled; secure Chatbox sessions are required.
WEBCHAT_LEGACY_ROUTES_ENABLED=false
