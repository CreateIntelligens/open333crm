NODE_ENV=production

DATABASE_URL=postgresql://crm:crmpassword@postgres:5432/open333crm
# Cross-tenant workers require the explicit admin/BYPASSRLS connection in production.
DATABASE_URL_ADMIN=postgresql://app_admin:change-me@postgres:5432/open333crm
REDIS_URL=redis://redis:6379

CREDENTIAL_ENCRYPTION_KEY=change-me-32-bytes-encryption-key!!
LICENSE_KEY=lic_local_dev
LICENSE_FETCH_URL=https://license.open333crm.com/v1/licenses/lic_local_dev
LICENSE_SIGNATURE_SECRET=local-dev-signature-secret

STORAGE_PROVIDER=minio
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=open333crm
S3_REGION=us-east-1
S3_PUBLIC_URL=http://localhost:9000

# 網站的公開網址（與 .env.api 的 WEB_BASE_URL 相同）。自動化傳送 FB 素材時，
# 素材裡的站內路徑（例如示範圖 /material-samples/...）換成這個網址開頭，Facebook 才收得到
WEB_BASE_URL=http://localhost:3000


# ─── Logging ──────────────────────────────────────────────────────────────────
LOG_TRANSPORT=console
LOG_DIR=./logs/workers
LOG_MAX_FILES=14d
LOG_LEVEL=info
