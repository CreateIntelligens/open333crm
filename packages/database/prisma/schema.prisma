generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgvector(map: "vector", schema: "public")]
}

// ─────────────────────────────────────────────
// Enums
// ─────────────────────────────────────────────

enum AgentRole {
  ADMIN
  SUPERVISOR
  AGENT
}

enum ChannelType {
  LINE
  FB
  WEBCHAT
  WHATSAPP
  TELEGRAM
  THREADS
}

enum ConversationStatus {
  ACTIVE
  BOT_HANDLED
  AGENT_HANDLED
  CLOSED
}

enum Direction {
  INBOUND
  OUTBOUND
}

enum SenderType {
  CONTACT
  AGENT
  BOT
  SYSTEM
}

enum ChatboxSessionRiskLevel {
  LOW
  MEDIUM
  HIGH
  REVOKED
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  PENDING
  RESOLVED
  ESCALATED
  CLOSED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TagType {
  MANUAL
  AUTO
  SYSTEM
  CHANNEL
}

enum TagScope {
  CONTACT
  CONVERSATION
  CASE
}

enum KmStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ScopeType {
  TENANT
  TEAM
  CHANNEL
}

enum ExecutionStatus {
  SUCCESS
  PARTIAL
  FAILED
}

enum ActionResultStatus {
  SUCCESS
  FAILED
  ROLLED_BACK
}

enum ExecutionState {
  RUNNING
  WAITING
  COMPLETED
  FAILED
}

enum FlowStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum NodeType {
  TRIGGER
  MESSAGE
  WAIT
  CONDITION
  API_FETCH
  AI_GEN
  ACTION
}

enum CampaignStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum BroadcastStatus {
  DRAFT
  SCHEDULED
  SENDING
  COMPLETED
  CANCELLED
  FAILED
}

enum PortalActivityType {
  POLL
  FORM
  QUIZ
}

enum PortalActivityStatus {
  DRAFT
  PUBLISHED
  ENDED
  ARCHIVED
}

enum TemplateViewStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
}

enum StitchSource {
  LIFF_COOKIE
  PHONE_MATCH
  EMAIL_MATCH
  MANUAL
  OTP_VERIFIED
}

enum SuggestionStatus {
  PENDING
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────
// Tenant
// ─────────────────────────────────────────────

model Tenant {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  isActive    Boolean  @default(true)
  // 平台層方案（nullable：既有租戶為 null = 不設功能天花板、無數值上限）
  planId      String?  @db.Uuid
  // 單租戶數值上限覆寫（有效上限 = limitOverrides[key] ?? plan.limits[key]）
  limitOverrides Json  @default("{}")
  // 試用到期時間（null = 非試用；轉正式時清 null）
  trialEndsAt DateTime?
  // 已寄出的到期提醒天數檔位（如 [7]），冪等閘避免重寄
  trialRemindersSent Json @default("[]")
  // 合約起訖日（純記錄，供平台方管理；nullable，MUST NOT 觸發任何自動生命週期行為，與 trialEndsAt 區隔）
  contractStartDate DateTime?
  contractEndDate   DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  plan                    Plan?    @relation(fields: [planId], references: [id])
  agents                  Agent[]
  roles                   Role[]
  channels                Channel[]
  contacts                Contact[]
  conversations           Conversation[]
  cases                   Case[]
  automationRules         AutomationRule[]
  automationExecutions    AutomationExecution[]
  automationActionResults AutomationActionResult[]
  interactionFlows        InteractionFlow[]
  flowExecutions          FlowExecution[]
  identityMaps            IdentityMap[]
  mergeSuggestions        MergeSuggestion[]
  notifications           Notification[]
  dailyStats              DailyStat[]
  tenantSettings          TenantSettings?
  campaigns               Campaign[]
  segments                Segment[]
  broadcasts              Broadcast[]
  webhookSubscriptions    WebhookSubscription[]
  portalActivities        PortalActivity[]
  portalSubmissions       PortalSubmission[]
  pointTransactions       PointTransaction[]
  shortLinks              ShortLink[]
  partnerApiKeys          PartnerApiKey[]
  cliSessions             CliSession[]
  materials               Material[]
  richMenus               RichMenu[]
  chatboxSessions         ChatboxSession[]
  passkeyCredentials      PasskeyCredential[]
  quickReplyPresets       QuickReplyPreset[]
  kbArticleFeedback       KbArticleFeedback[]
  aiUsages                AiUsage[]
  planChangeRequests      PlanChangeRequest[]

  @@map("tenants")
}

// ─────────────────────────────────────────────
// Agent（客服人員）
// ─────────────────────────────────────────────

model Agent {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @db.Uuid
  email        String
  name         String
  avatarUrl    String?
  role         AgentRole @default(AGENT)
  // 細粒度 RBAC：指向 Role 表；過渡期 nullable，與 role enum 雙寫，最終移除 enum
  roleId       String?   @db.Uuid
  isActive     Boolean   @default(true)
  passwordHash String
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant  Tenant @relation(fields: [tenantId], references: [id])
  roleRef Role?  @relation(fields: [roleId], references: [id])

  teams              AgentTeamMember[]
  assignedConvs      Conversation[]      @relation("AssignedAgent")
  assignedCases      Case[]              @relation("AssignedAgent")
  caseEvents         CaseEvent[]
  sentMessages       Message[]
  notifications      Notification[]
  cliSessions        CliSession[]
  passkeyCredentials PasskeyCredential[]

  // email 全域唯一：一個 email 只能屬於一個租戶（多租戶登入靠 email 解析租戶）
  @@unique([email])
  @@index([tenantId])
  @@index([roleId])
  @@map("agents")
}

// ─────────────────────────────────────────────
// RBAC: Role / RolePermission（細粒度權限，見 rbac-granular-permissions）
// ─────────────────────────────────────────────

model Role {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  // system role: admin/supervisor/agent（不可刪、slug 不可改）；custom role 自訂
  slug      String
  name      String
  isSystem  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant      Tenant           @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  agents      Agent[]

  // 角色 slug 於租戶內唯一（比照 Tag 等租戶內唯一慣例，非全域）
  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("roles")
}

model RolePermission {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  roleId         String   @db.Uuid
  // 對應 permissions registry 的 code（registry 在程式碼，不設 DB FK；寫入時驗證存在）
  permissionCode String
  createdAt      DateTime @default(now())

  // 隨所屬 Role 一起刪除；本身不帶 tenantId，靠 Role 間接隔離（比照 CaseTag）
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionCode])
  @@index([roleId])
  @@map("role_permissions")
}

// ─────────────────────────────────────────────
// Team
// ─────────────────────────────────────────────

model Team {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId      String   @db.Uuid
  name          String
  licenseTeamId String? // 對應 License JSON teams[].teamId（平台方分配字串）
  createdAt     DateTime @default(now())

  members         AgentTeamMember[]
  cases           Case[]
  conversations   Conversation[]
  channelAccesses ChannelTeamAccess[]
  channelUsages   ChannelUsage[]

  @@index([tenantId])
  @@map("teams")
}

model AgentTeamMember {
  agentId String @db.Uuid
  teamId  String @db.Uuid

  agent Agent @relation(fields: [agentId], references: [id], onDelete: Cascade)
  team  Team  @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([agentId, teamId])
  @@map("agent_team_members")
}

// ─────────────────────────────────────────────
// Channel（渠道）
// ─────────────────────────────────────────────

model Channel {
  id                   String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String      @db.Uuid
  channelType          ChannelType
  displayName          String
  publicKey            String?     @unique
  isActive             Boolean     @default(true)
  credentialsEncrypted String // AES-256 加密後的 JSON
  settings             Json        @default("{}")
  webhookUrl           String?
  lastVerifiedAt       DateTime?
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  channelIdentities ChannelIdentity[]
  conversations     Conversation[]
  teamAccesses      ChannelTeamAccess[]
  usages            ChannelUsage[]
  richMenus         RichMenu[]
  chatboxSessions   ChatboxSession[]
  shortLinks        ShortLink[]         @relation("ShortLinkLineChannel")

  @@index([tenantId])
  @@index([publicKey])
  @@map("channels")
}

// ─────────────────────────────────────────────
// Channel 多部門授權
// ─────────────────────────────────────────────

model ChannelTeamAccess {
  channelId   String   @db.Uuid
  teamId      String   @db.Uuid
  // full | reply_only | read_only
  accessLevel String   @default("full")
  grantedAt   DateTime @default(now())
  grantedById String?  @db.Uuid

  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  team    Team    @relation(fields: [teamId], references: [id], onDelete: Cascade)

  @@id([channelId, teamId])
  @@index([teamId])
  @@map("channel_team_accesses")
}

// ─────────────────────────────────────────────
// 渠道計費記錄
// ─────────────────────────────────────────────

model ChannelUsage {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId    String    @db.Uuid
  teamId       String?   @db.Uuid
  direction    Direction
  messageCount Int       @default(1)
  feeAmount    Float?
  feeCurrency  String?
  recordedAt   DateTime  @default(now())

  channel Channel @relation(fields: [channelId], references: [id])
  team    Team?   @relation(fields: [teamId], references: [id])

  @@index([channelId, recordedAt])
  @@index([teamId, recordedAt])
  @@map("channel_usages")
}

// ─────────────────────────────────────────────
// Contact（聯繫人）
// ─────────────────────────────────────────────

model Contact {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  displayName  String
  avatarUrl    String?
  phone        String?
  email        String?
  language     String   @default("zh-TW")
  isBlocked    Boolean  @default(false)
  isArchived   Boolean  @default(false)
  mergedIntoId String?  @db.Uuid
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  channelIdentities ChannelIdentity[]
  attributes        ContactAttribute[]
  tags              ContactTag[]
  relationsFrom     ContactRelation[]  @relation("FromContact")
  relationsTo       ContactRelation[]  @relation("ToContact")
  conversations     Conversation[]
  cases             Case[]
  longTermMemories  LongTermMemory[]
  identityMaps      IdentityMap[]
  portalSubmissions PortalSubmission[]
  pointTransactions PointTransaction[]

  @@index([tenantId])
  @@index([tenantId, phone])
  @@index([tenantId, email])
  @@map("contacts")
}

model ChannelIdentity {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId   String      @db.Uuid
  channelId   String      @db.Uuid
  channelType ChannelType
  uid         String
  profileName String?
  profilePic  String?
  linkedAt    DateTime    @default(now())

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  channel Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@unique([channelId, uid])
  @@index([contactId])
  @@map("channel_identities")
}

model ContactAttribute {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId String @db.Uuid
  key       String
  value     String
  dataType  String @default("string")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@unique([contactId, key])
  @@map("contact_attributes")
}

model ContactRelation {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromContactId String   @db.Uuid
  toContactId   String   @db.Uuid
  relationType  String
  notes         String?
  createdAt     DateTime @default(now())

  fromContact Contact @relation("FromContact", fields: [fromContactId], references: [id], onDelete: Cascade)
  toContact   Contact @relation("ToContact", fields: [toContactId], references: [id], onDelete: Cascade)

  @@unique([fromContactId, toContactId, relationType])
  @@map("contact_relations")
}

// ─────────────────────────────────────────────
// Tag（標籤）
// ─────────────────────────────────────────────

model Tag {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String?  @db.Uuid
  name        String
  color       String   @default("#6366f1")
  type        TagType  @default(MANUAL)
  scope       TagScope @default(CONTACT)
  description String?
  createdAt   DateTime @default(now())

  contactTags      ContactTag[]
  caseTags         CaseTag[]
  conversationTags ConversationTag[]

  @@unique([tenantId, name, scope])
  @@map("tags")
}

model ContactTag {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId String    @db.Uuid
  tagId     String    @db.Uuid
  addedBy   String    @default("agent")
  addedById String?   @db.Uuid
  addedAt   DateTime  @default(now())
  expiresAt DateTime?

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  tag     Tag     @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([contactId, tagId])
  @@map("contact_tags")
}

model CaseTag {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId    String    @db.Uuid
  tagId     String    @db.Uuid
  addedBy   String    @default("agent")
  addedById String?   @db.Uuid
  addedAt   DateTime  @default(now())
  expiresAt DateTime?

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([caseId, tagId])
  @@index([caseId])
  @@index([tagId])
  @@map("case_tags")
}

model ConversationTag {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String    @db.Uuid
  tagId          String    @db.Uuid
  addedBy        String    @default("agent")
  addedById      String?   @db.Uuid
  addedAt        DateTime  @default(now())
  expiresAt      DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  tag          Tag          @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([conversationId, tagId])
  @@index([conversationId])
  @@index([tagId])
  @@map("conversation_tags")
}

// ─────────────────────────────────────────────
// Conversation & Message
// ─────────────────────────────────────────────

model Conversation {
  id              String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String             @db.Uuid
  contactId       String             @db.Uuid
  channelId       String             @db.Uuid
  teamId          String?            @db.Uuid
  channelType     ChannelType
  status          ConversationStatus @default(ACTIVE)
  assignedToId    String?            @db.Uuid
  caseId          String?            @db.Uuid
  unreadCount     Int                @default(0)
  lastMessageAt   DateTime?
  botRepliesCount Int                @default(0)
  handoffReason   String?
  metadata        Json               @default("{}")
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  contact        Contact           @relation(fields: [contactId], references: [id])
  channel        Channel           @relation(fields: [channelId], references: [id])
  team           Team?             @relation(fields: [teamId], references: [id])
  assignedTo     Agent?            @relation("AssignedAgent", fields: [assignedToId], references: [id])
  case           Case?             @relation(fields: [caseId], references: [id])
  messages       Message[]
  tags           ConversationTag[]
  chatboxSession ChatboxSession?

  @@index([tenantId, status])
  @@index([tenantId, contactId])
  @@index([caseId])
  @@index([tenantId, lastMessageAt(sort: Desc)])
  @@map("conversations")
}

model Message {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String     @db.Uuid
  direction       Direction  @default(INBOUND)
  senderType      SenderType
  senderId        String?    @db.Uuid
  contentType     String
  content         Json
  metadata        Json       @default("{}")
  channelMsgId    String?
  clientMessageId String?
  sequence        Int?
  isRead          Boolean    @default(false)
  createdAt       DateTime   @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       Agent?       @relation(fields: [senderId], references: [id])

  @@unique([conversationId, clientMessageId])
  // 平台訊息 id 去重：IG/FB 等會重複投遞同一 webhook，靠此約束擋掉併發重複建立
  @@unique([conversationId, channelMsgId])
  @@index([conversationId, createdAt])
  @@index([conversationId, sequence])
  @@map("messages")
}

model ChatboxSession {
  id                 String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId           String                  @db.Uuid
  channelId          String                  @db.Uuid
  conversationId     String                  @unique @db.Uuid
  visitorToken       String                  @unique @db.Uuid
  tokenDigest        String                  @unique
  fingerprintHash    String
  fingerprintVersion Int                     @default(1)
  expiresAt          DateTime
  lastSeenAt         DateTime?
  revokedAt          DateTime?
  riskLevel          ChatboxSessionRiskLevel @default(LOW)
  metadata           Json                    @default("{}")
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  tenant       Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  channel      Channel      @relation(fields: [channelId], references: [id], onDelete: Cascade)
  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([tenantId, channelId])
  @@index([expiresAt])
  @@index([fingerprintHash])
  @@map("chatbox_sessions")
}

// ─────────────────────────────────────────────
// Case（案件）
// ─────────────────────────────────────────────

model Case {
  id              String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId        String     @db.Uuid
  contactId       String     @db.Uuid
  channelId       String     @db.Uuid
  title           String
  description     String?
  status          CaseStatus @default(OPEN)
  priority        Priority   @default(MEDIUM)
  category        String?
  assigneeId      String?    @db.Uuid
  teamId          String?    @db.Uuid
  slaPolicy       String?
  slaDueAt        DateTime?
  firstResponseAt DateTime?
  resolvedAt      DateTime?
  closedAt        DateTime?
  csatScore       Int?
  csatComment     String?
  csatRespondedAt DateTime?
  csatSentAt      DateTime?
  mergedIntoId    String?    @db.Uuid
  parentCaseId    String?    @db.Uuid
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  tenant        Tenant         @relation(fields: [tenantId], references: [id])
  contact       Contact        @relation(fields: [contactId], references: [id])
  assignee      Agent?         @relation("AssignedAgent", fields: [assigneeId], references: [id])
  team          Team?          @relation(fields: [teamId], references: [id])
  conversations Conversation[]

  mergedInto  Case?  @relation("MergedCases", fields: [mergedIntoId], references: [id])
  mergedCases Case[] @relation("MergedCases")
  parentCase  Case?  @relation("SubCases", fields: [parentCaseId], references: [id])
  subCases    Case[] @relation("SubCases")

  relationsFrom CaseRelation[] @relation("FromCase")
  relationsTo   CaseRelation[] @relation("ToCase")

  events CaseEvent[]
  notes  CaseNote[]
  tags   CaseTag[]

  @@index([tenantId, status])
  @@index([tenantId, assigneeId])
  @@index([tenantId, slaDueAt])
  @@map("cases")
}

model CaseEvent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId    String   @db.Uuid
  actorType String
  actorId   String?  @db.Uuid
  eventType String
  payload   Json     @default("{}")
  createdAt DateTime @default(now())

  case  Case   @relation(fields: [caseId], references: [id], onDelete: Cascade)
  actor Agent? @relation(fields: [actorId], references: [id])

  @@index([caseId])
  @@map("case_events")
}

model CaseNote {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  caseId     String   @db.Uuid
  agentId    String   @db.Uuid
  content    String
  isInternal Boolean  @default(true)
  createdAt  DateTime @default(now())

  case Case @relation(fields: [caseId], references: [id], onDelete: Cascade)

  @@index([caseId])
  @@map("case_notes")
}

model CaseRelation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fromCaseId   String   @db.Uuid
  toCaseId     String   @db.Uuid
  relationType String // relates_to | blocks | duplicates
  createdAt    DateTime @default(now())

  fromCase Case @relation("FromCase", fields: [fromCaseId], references: [id], onDelete: Cascade)
  toCase   Case @relation("ToCase", fields: [toCaseId], references: [id], onDelete: Cascade)

  @@index([fromCaseId])
  @@index([toCaseId])
  @@map("case_relations")
}

model SlaPolicy {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId             String   @db.Uuid
  name                 String
  priority             Priority
  firstResponseMinutes Int
  resolutionMinutes    Int
  warningBeforeMinutes Int      @default(30)
  isDefault            Boolean  @default(false)
  createdAt            DateTime @default(now())

  @@index([tenantId])
  @@map("sla_policies")
}

// ─────────────────────────────────────────────
// Automation Engine
// ─────────────────────────────────────────────

model AutomationRule {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @db.Uuid
  name           String
  description    String?
  enabled        Boolean   @default(true)
  isActive       Boolean   @default(true)
  eventType      String    @default("")
  priority       Int       @default(0)
  stopProcessing Boolean   @default(false)
  stopOnMatch    Boolean   @default(false)
  scopeType      ScopeType @default(TENANT)
  scopeId        String?
  trigger        Json      @default("{}")
  conditions     Json      @default("{}")
  actions        Json      @default("[]")
  runCount       Int       @default(0)
  lastRunAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  executions AutomationExecution[]
  logs       AutomationLog[]

  @@index([tenantId, isActive])
  @@index([eventType])
  @@map("automation_rules")
}

model AutomationExecution {
  id               String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String          @db.Uuid
  ruleId           String?         @db.Uuid
  eventType        String
  eventId          String?
  factSnapshot     Json
  candidateRuleIds String[]
  matchedRuleIds   String[]
  actionsExecuted  Json
  stoppedAt        String?
  status           ExecutionStatus
