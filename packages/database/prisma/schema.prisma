  lastUsedAt  DateTime?
  isActive    Boolean   @default(true)
  createdById String    @db.Uuid
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, isActive])
  @@index([keyPrefix])
  @@map("partner_api_keys")
}

// ─────────────────────────────────────────────
// CLI Sessions
// ─────────────────────────────────────────────

model CliSession {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String    @db.Uuid
  agentId     String    @db.Uuid
  name        String
  tokenHash   String
  tokenPrefix String    @db.VarChar(9)
  tokenSuffix String    @db.VarChar(4)
  scopes      Json      @default("[]")
  expiresAt   DateTime
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  agent  Agent  @relation(fields: [agentId], references: [id])

  @@index([tokenPrefix])
  @@index([tenantId, agentId])
  @@index([tenantId, revokedAt, expiresAt])
  @@map("cli_sessions")
}

// ─────────────────────────────────────────────
// Passkey Credentials
// ─────────────────────────────────────────────

model PasskeyCredential {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String    @db.Uuid
  agentId      String    @db.Uuid
  credentialId String    @unique @db.VarChar(1024)
  publicKey    Bytes
  counter      BigInt    @default(0)
  transports   Json      @default("[]")
  deviceType   String?
  backedUp     Boolean   @default(false)
  name         String    @default("Passkey")
  lastUsedAt   DateTime?
  revokedAt    DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  agent  Agent  @relation(fields: [agentId], references: [id])

  @@index([tenantId, agentId, revokedAt])
  @@map("passkey_credentials")
}

// ─────────────────────────────────────────────
// Quick Reply Preset（LINE 客服可重用的快速回覆按鈕組）
// ─────────────────────────────────────────────

model QuickReplyPreset {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String   @db.Uuid
  name      String
  items     Json
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, isActive])
  @@map("quick_reply_presets")
}

// ─────────────────────────────────────────────
// KB 文章回報（AI 回答品質回饋迴路：測試者/用戶回報答案不好 → 後台調教 KB）
// ─────────────────────────────────────────────

model KbArticleFeedback {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String   @db.Uuid
  articleId    String   @db.Uuid
  messageId    String?  @db.Uuid
  userQuestion String?
  botReply     String?
  confidence   Float?
  rating       String   @default("bad")
  contactId    String?  @db.Uuid
  status       String   @default("open")
  createdAt    DateTime @default(now())

  tenant  Tenant    @relation(fields: [tenantId], references: [id])
  article KmArticle @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([tenantId, articleId])
  @@index([tenantId, status])
  @@map("kb_article_feedback")
}

// ─────────────────────────────────────────────
// AI 用量記錄（每次 LLM 呼叫一筆 raw log；計費/額度/統計的資料源）
// ─────────────────────────────────────────────

model AiUsage {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId         String   @db.Uuid
  provider         String // 'gemini' | 'ollama'
  model            String
  // 呼叫來源：kb-autoreply | summary | classify | sentiment | automation | unknown
  feature          String   @default("unknown")
  promptTokens     Int      @default(0)
  cachedTokens     Int      @default(0)
  candidatesTokens Int      @default(0)
  thoughtsTokens   Int      @default(0)
  totalTokens      Int      @default(0)
  // 寫入當下以 ModelPricing 快照計算的成本（USD）；改價不回溯歷史帳
  costUsd          Decimal  @default(0) @db.Decimal(12, 8)
  success          Boolean  @default(true)
  // provider 未回傳用量或查無價目時為 true（token/cost 為 0 非真實值）
  usageMissing     Boolean  @default(false)
  // key 來源：platform（平台/env key，成本歸平台）| byok（租戶自備，成本不歸平台）
  keySource        String   @default("platform")
  errorCode        String?
  // soft reference：刻意不設 FK，避免刪對話/案件連坐刪用量帳
  conversationId   String?  @db.Uuid
  caseId           String?  @db.Uuid
  createdAt        DateTime @default(now())

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, createdAt])
  @@index([tenantId, feature])
  @@map("ai_usages")
}

// 模型單價（平台層全域資料，刻意不帶 tenantId）。
// 以 (model, effectiveFrom) 版本化：改價一律新增一列不修改既有列，
// 查價取該模型 effectiveFrom <= now 的最新一列。
model ModelPricing {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  model           String
  inputPer1M      Decimal  @db.Decimal(12, 6)
  outputPer1M     Decimal  @db.Decimal(12, 6)
  cachedPer1M     Decimal  @db.Decimal(12, 6)
  // 分級價（如 gemini-2.5-pro 超過 200k prompt token 整筆改用 tier 價）
  tierThreshold   Int?
  tierInputPer1M  Decimal? @db.Decimal(12, 6)
  tierOutputPer1M Decimal? @db.Decimal(12, 6)
  effectiveFrom   DateTime @default(now())
  createdAt       DateTime @default(now())

  @@unique([model, effectiveFrom])
  @@map("model_pricings")
}

// ─────────────────────────────────────────────
// 平台層（Platform Control Plane）— 全域資料，刻意不帶 tenantId
// ─────────────────────────────────────────────

// 方案（平台全域）。features = 功能天花板；limits = 數值上限 Json（null=無上限）。
model Plan {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug         String   @unique // trial | light | standard | professional | enterprise
  name         String
  features     Json     @default("[]") // string[]：方案含的 feature module slug
  limits       Json     @default("{}") // { maxAgents, maxTags, monthlyTokens, maxChannels, ... }；值 null=無上限
  // ChannelType[] 白名單：方案可用的渠道類型。空陣列 [] = 不限制（可用全部）。只擋新建，不影響既有渠道。
  allowedChannelTypes Json @default("[]")
  // 功能點細分：從 feature 天花板再扣掉的權限碼。形狀 { deny: string[] }。deny 高階不連坐低階。
  permissionOverrides Json @default("{}")
  priceMonthly Int? // 顯示用，不接金流；企業版可 null
  isActive     Boolean  @default(true) // 停售軟下架
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  tenants Tenant[]

  @@map("plans")
}

// 平台 superuser（跨租戶身分，與 Agent 完全分離）。
model PlatformUser {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email        String    @unique
  name         String
  passwordHash String
  isActive     Boolean   @default(true)
  lastLoginAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  auditLogs PlatformAuditLog[]

  @@map("platform_users")
}

// 平台操作稽核（開通/停用租戶、改 plan、改設定；platformUserId 為 null = 系統排程動作）。
model PlatformAuditLog {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  platformUserId String?  @db.Uuid
  action         String // e.g. tenant.provision | tenant.disable | plan.update | tenant.trial.expire
  targetType     String? // tenant | plan | setting
  targetId       String?
  payload        Json? // 變更摘要
  createdAt      DateTime @default(now())

  platformUser PlatformUser? @relation(fields: [platformUserId], references: [id])

  @@index([platformUserId, createdAt])
  @@map("platform_audit_logs")
}

// 平台全域設定（KV）。承載 trial.* 政策參數等。
model PlatformSetting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

// 免費試用申請（平台全域資料——申請發生在租戶存在之前，刻意不帶 tenantId）。
// emailNormalized @unique + row 永不刪 = 一 email 一次、到期不能再申請。
model TrialSignup {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String // 原始 lowercase，開通時用它建 Agent（既有 login 大小寫敏感）
  emailNormalized      String    @unique // 去 gmail +tag/dots 的正規化值，唯一鍵擋別名重複
  siteName             String
  passwordHash         String // 申請時即 bcrypt，開通時搬給 Agent
  // pending_verification | provisioned | failed
  status               String    @default("pending_verification")
  verifyTokenHash      String?   @unique // sha256(32-byte random)；明文只出現在信裡
  verifyTokenExpiresAt DateTime?
  verifySentCount      Int       @default(0)
  lastVerifySentAt     DateTime?
  requestIp            String?
  tenantId             String?   @db.Uuid // 開通後回填（soft ref，不設 FK）
  provisionedAt        DateTime?
  failureReason        String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  @@map("trial_signups")
}

// 方案升級/加購申請（租戶發起 → 平台審核核准）。
model PlanChangeRequest {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @db.Uuid
  // upgrade（升級方案）| token_topup（加購 token）
  type           String
  // upgrade 用：目標方案 slug
  targetPlanSlug String?
  // token_topup 用：加購 token 數
  topupTokens    Int?
  note           String? // 租戶備註
  // pending | approved | rejected
  status         String    @default("pending")
  reviewNote     String? // 平台審核備註
  reviewedBy     String?   @db.Uuid // platformUserId
  reviewedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])

  @@index([tenantId, status])
  @@index([status, createdAt])
  @@map("plan_change_requests")
}
