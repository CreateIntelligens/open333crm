# Official 888a2a-lite bridge runtime configuration.
# Copy to a local, ignored env file or inject through a secret manager.
A2A_HUB_URL=https://a2a.david888.com
A2A_HUB_KEY=replace-with-runtime-secret
A2A_AGENT_NAME=Open333CRM
A2A_AGENT_CREDENTIALS=~/.a2a/credentials_open333crm.json
A2A_QUEUE_DB=~/.a2a/open333crm-work.db

# The bridge invokes the already authenticated Open333 CLI profile.
OPEN333_PROFILE=default
A2A_BRIDGE_COMMAND=open333 a2a:execute --profile default
A2A_CRM_ADAPTER_ENABLED=true
A2A_PROMPT_MAX_LENGTH=20000
A2A_ADAPTER_TIMEOUT_MS=120000
