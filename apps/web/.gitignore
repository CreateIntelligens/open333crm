# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
# Playwright storage state：內含 UAT 的 refreshToken / platformToken，
# 是可直接換到有效 access token 的真實憑證，絕不可進版控。
# 原本只擋 auth-state.json，漏掉 -agent / -supervisor / -platform 三個變體，
# 2026-09-23 被 PR review 抓到已提交（已從索引移除並輪替憑證）。
auth-state*.json

# Playwright 測試產物（報告內含 request URL、trace、錯誤內容）
playwright-report*/
test-results/
test-results/
.manual-archive/
