NODE_ENV=production
# NEXT_PUBLIC_* 會被打包進瀏覽器端 JS，不能用 docker-compose 內部 service name（如 api:3001），
# 瀏覽器解析不到。本機用 docker-compose.dev.yml（無 Caddy，直接曝 port）：http://localhost:3001/api
# 走 Caddy（docker-compose.yml，port 80）：改成 http://localhost/api
# 正式環境：改成對外網域，例如 https://crm.example.com/api
NEXT_PUBLIC_API_URL=http://localhost:3001/api

# 登入頁 playcaptcha 夾娃娃機小遊戲關卡。預設啟用（未設定＝啟用）。
# demo／E2E 測試環境請設為 false 以繞過（E2E 亦以 Playwright 驅動，會被關卡擋住）。
NEXT_PUBLIC_LOGIN_CAPTCHA_ENABLED=true
