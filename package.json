{
  "name": "open333crm",
  "version": "0.3.0",
  "private": true,
  "license": "GPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=24.22.1 <25"
  },
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "lint": "turbo lint",
    "test": "turbo test",
    "test:feature": "turbo test:feature --concurrency=1",
    "test:all": "pnpm test && pnpm test:feature",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "pnpm --filter @open333crm/database exec prisma generate",
    "db:migrate": "pnpm --filter @open333crm/database exec prisma migrate dev",
    "db:seed": "pnpm --filter @open333crm/database exec prisma db seed",
    "db:studio": "pnpm --filter @open333crm/database exec prisma studio",
    "api:docs:generate": "pnpm --filter @open333crm/api openapi:generate",
    "cli:build": "pnpm --filter @open333crm/cli build",
    "cli:dev": "pnpm --filter @open333crm/cli dev",
    "cli:sandbox": "pnpm cli:build && mkdir -p /tmp/open333-npm-cache /tmp/open333-cli-sandbox && TARBALL=$(NPM_CONFIG_CACHE=/tmp/open333-npm-cache pnpm --silent --filter @open333crm/cli exec npm pack --pack-destination /tmp) && NPM_CONFIG_CACHE=/tmp/open333-npm-cache npm install --prefix /tmp/open333-cli-sandbox -g /tmp/$TARBALL && /tmp/open333-cli-sandbox/bin/open333 --help && /tmp/open333-cli-sandbox/bin/open333 login --help && /tmp/open333-cli-sandbox/bin/open333 status --help && /tmp/open333-cli-sandbox/bin/open333 apis --help && /tmp/open333-cli-sandbox/bin/open333 stats --help",
    "cli:publish:dry-run": "pnpm cli:build && pnpm --filter @open333crm/cli exec npm publish --dry-run --access public",
    "cli:publish": "pnpm cli:sandbox && pnpm --filter @open333crm/cli exec npm publish --access public"
  },
  "devDependencies": {
    "@fission-ai/openspec": "1.14.1",
    "@types/node": "^24.19.0",
    "@typescript-eslint/eslint-plugin": "^8.57.1",
    "@typescript-eslint/parser": "^8.57.1",
    "eslint": "^9",
    "prettier": "^3.0.0",
    "turbo": "^2.9.14",
    "vite": "^8.3.3",
    "vitest": "^5.0.3"
  },
  "pnpm": {
    "overrides": {
      "@xmldom/xmldom": "0.8.15",
      "defu": "6.1.7",
      "effect": "3.21.4",
      "fast-uri": "3.1.8",
      "find-my-way": "9.9.0",
      "sharp": "0.35.5",
      "fast-xml-builder": "1.1.9",
      "form-data": "4.0.6",
      "lodash": "4.18.1",
      "nanoid": "3.3.18",
      "postcss": "8.5.26",
      "engine.io": "6.6.10",
      "socket.io-parser": "4.2.7",
      "ws": "8.21.0",
      "adm-zip": "0.6.1",
      "baseline-browser-mapping": "2.11.0",
      "brace-expansion@<1.1.21": "1.1.21",
      "brace-expansion@>=2.0.0 <2.1.7": "2.1.7",
      "brace-expansion@>=4.0.0 <5.0.12": "5.0.12",
      "browserslist": "4.28.7",
      "deepmerge-ts": "8.0.0",
      "esbuild@>=0.27.3 <0.28.1": "0.28.2",
      "fast-copy": "3.1.0",
      "fast-xml-parser": "5.7.0",
      "@fastify/busboy": "3.2.2",
      "follow-redirects": "1.16.1",
      "hono": "4.13.11",
      "@humanfs/node": "0.16.8",
      "ip-address": "10.7.1",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "moment": "2.31.0",
      "picomatch@<2.3.2": "2.3.2",
      "postcss-selector-parser": "7.1.6",
      "proxy-addr": "2.0.8",
      "qs": "6.16.0",
      "source-map-js": "1.2.2",
      "tar": "7.5.21",
      "uuid@<11.1.1": "11.1.1"
    }
  },
  "packageManager": "pnpm@9.0.0"
}
